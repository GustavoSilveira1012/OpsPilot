{
  "name": "@opspilot/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "clean": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\"",
    "dev": "next dev --hostname 0.0.0.0",
    "lint": "eslint src --max-warnings=0",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@opspilot/contracts": "workspace:*",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@opspilot/eslint-config": "workspace:*",
    "@opspilot/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
